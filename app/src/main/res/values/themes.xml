<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One native launch surface, followed directly by the first app frame. -->
    <style name="Theme.Phosphor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">520</item>
        <item name="postSplashScreenTheme">@style/Theme.Phosphor</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/sky</item>
        <item name="android:navigationBarColor">@color/sky</item>
    </style>

    <style name="Theme.Phosphor" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/ultramarine</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
